{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://13.234.202.16:5000/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "http://13.234.202.16:5000/uploads/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "http://13.234.202.16:5000/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
